# Copy to .env (gitignored) or export in your shell.
# Matches docker-compose.yml's db service.
DATABASE_URL=postgres://ccc:ccc@127.0.0.1:5432/ccc

# The invite code every registration must present. REQUIRED to let anyone sign up: with this
# unset, /v1/auth/register refuses everything (a default-open gate would be no gate at all).
INVITE_CODE=change-me

# Server bind (main.ts defaults: 8787 / 0.0.0.0 so a phone on the LAN can reach it)
# PORT=8787
# HOST=0.0.0.0

# How far back to load sessions into the in-memory read cache on boot (default 30)
# CCC_LOAD_WINDOW_DAYS=30
